# ==========================================
# BLOODY SWEET — Environment Variables
# ==========================================

# GEMINI_API_KEY: Optional AI API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Current web application deployment URL
APP_URL="MY_APP_URL"

# ==========================================
# FIREBASE AUTHENTICATION & CLOUD FIRESTORE
# ==========================================
# Retrieve these values from Firebase Console:
# Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Note: In Firebase Console > Authentication > Settings > Authorized Domains,
# ensure your deployed app host and localhost are added.
